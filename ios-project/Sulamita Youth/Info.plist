<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Capture Audio by user request</string>
	<!-- F14: NSLocationWhenInUseUsageDescription removed. The site never calls
	     geolocation (youth-track.js does the IP lookup in-process), so the key was
	     an App Review question with no good answer. -->
	<key>NSCameraUsageDescription</key>
	<string>Capture Video by user request</string>
	<!-- F8: the long-press "Save to Photos" on an album <img> is how most people
	     will actually save a photograph, and it is unavailable without the Add key. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save a photo from the church albums to your camera roll.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Attach a photo from your library to a suggestion, a sign-up or a receipt.</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sulamita Youth</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string></string>
			<key>CFBundleURLSchemes</key>
			<array />
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- F10: canOpenURL answers false for any scheme not declared here, which is why
	     the YF portal's viber:// invites were silently swallowed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>viber</string>
		<string>tel</string>
		<string>mailto</string>
		<string>sms</string>
		<string>maps</string>
		<string>comgooglemaps</string>
		<string>instagram</string>
		<string>itms-apps</string>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- F7 (option A): remote-notification removed. Nothing registers for remote
	     notifications (AppDelegate's registerForRemoteNotifications() is commented
	     out), and declaring a background mode with nothing behind it is a common
	     App Review rejection. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- F14: was armv7 (32-bit, template leftover). No current Xcode emits an armv7
	     slice, so the declared requirement can never be satisfied by the binary. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- F1 + F2: app-bound domains gates main-frame navigation (and is what keeps the
	     service workers alive), so every host in Settings.swift's allowedOrigins has to
	     be here too, plus the hosts Square and Flickr draw their iframes from. Six of
	     the ten allowed entries. Matching covers subdomains: cash.app covers
	     api.cash.app. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>youth.sulamitachurch.com</string>
		<string>merch.sulamitachurch.com</string>
		<string>cash.app</string>
		<string>web.squarecdn.com</string>
		<string>pci-connect.squareup.com</string>
		<string>embedr.flickr.com</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>https://youth.sulamitachurch.com/albums/</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Photos</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>https://youth.sulamitachurch.com/people/</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>People</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>https://youth.sulamitachurch.com/youth-calendar/</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Calendar</string>
		</dict>
	</array>
</dict>
</plist>
